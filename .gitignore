# environments
.venv/
__pycache__/
*.pyc
.pytest_cache/

# pipeline runs (heavy artifacts)
pipeline/runs/
capture/inbox/

# web (built by vite)
web/node_modules/
web/dist/
web/public/artifacts/*
!web/public/artifacts/README.md
!web/public/artifacts/room/
!web/public/artifacts/room/**

# kaggle tooling
kaggle/staging/
kaggle/out/
kaggle/config.local.ps1

# large media kept out of git (sample data under test/ is allowed)
*.mp4
*.mov
!test/**/*.mp4

# demo video intermediates; the final MP4 is a GitHub release asset
docs/demo/build/
docs/demo/build_r2/

# local secrets (never commit)
kaggle.json
.env
*_secret*
